{
  "tag": "halfspace",
  "major": 3,
  "minor": 0,
  "meta": {
    "description": "Closed-form Perlin noise",
    "name": null
  },
  "world": {
    "next_index": 2,
    "order": [
      0,
      1
    ],
    "blocks": {
      "1": {
        "Script": {
          "name": "gen",
          "script": "let shape = input(\"shape\");\nlet s = input(\"scale\");\nlet w = input(\"weight\");\noutput(\"out\", shape + shape.scale([s, s]) * w);",
          "inputs": {
            "scale": "0.4",
            "weight": "0.8",
            "shape": "noise"
          }
        }
      },
      "0": {
        "Script": {
          "name": "noise",
          "script": "/// Closed-form Perlin noise\nfn weight(ix, iy) {\n    let fx = floor(x) + ix;\n    let fy = floor(y) + iy;\n    let dx = x - fx;\n    let dy = y - fy;\n    let angle = rand(mix(fx, fy)) * 2.0 * PI;\n    let dir_x = cos(angle);\n    let dir_y = sin(angle);\n    dx * dir_x + dy * dir_y\n}\n\nfn smoothstep(v) {\n    let t = v - floor(v);\n    return t * t * (3.0 - 2.0 * t);\n}\n\nlet wa = weight(0, 0);\nlet wb = weight(1, 0);\nlet wc = weight(0, 1);\nlet wd = weight(1, 1);\n\nlet wab = wa  + smoothstep(x) * (wb  - wa);\nlet wcd = wc  + smoothstep(x) * (wd  - wc);\nlet w   = wab + smoothstep(y) * (wcd - wab);\n\noutput(\"out\", w)\n",
          "inputs": {}
        }
      }
    }
  },
